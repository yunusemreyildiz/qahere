# Bu dosya isteğe bağlıdır. Ayarların tamamı arayüzden (ilk açılış adımları ve Ayarlar) yapılır
# ve data/settings.json içinde, yalnızca senin bilgisayarında saklanır.
# Buradaki değerler yalnızca arayüzden ayar yapılmadıysa başlangıç değeri olarak okunur.

# --- Jira (isteğe bağlı) ---------------------------------------------------------
# JIRA_BASE_URL=https://sirketin.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECTS=APP,WEB

# --- Görünüm (isteğe bağlı) ------------------------------------------------------
# WORKSPACE_NAME=
# ACCENT_COLOR="#0071e3"

# --- Claude Code -----------------------------------------------------------------
# CLAUDE_MODEL=sonnet
# claude komutu PATH'te değilse tam yolu
# CLAUDE_BIN=claude
# Tek bir rehber üretimi için azami süre (dakika)
# GENERATE_TIMEOUT_MIN=20
# Bağlantıların farklı adla kuruluysa ek OKUMA araçları (virgülle)
# CLAUDE_EXTRA_ALLOWED_TOOLS=

# --- Sunucu ----------------------------------------------------------------------
# PORT=4310
